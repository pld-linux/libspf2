+/* RFC 7208 4.6.4: at most max_dns_mech DNS terms per check, includes
+ * counted in; one more is a permerror before its lookup. */
+#define SPF_ADD_DNS_MECH() do { \
+		if (++spf_response->num_dns_mech > spf_server->max_dns_mech) { \
+			SPF_FREE_LOOKUP_DATA(); \
+			return DONE(SPF_RESULT_PERMERROR, SPF_REASON_NONE, SPF_E_BIG_DNS); \
+		} \
+	} while(0)
 
