RFC 7208 7.3: an expanded domain name over 253 chars is truncated on
the left, label by label, until it fits; libspf2 queried the whole name
(a, mx, ptr, include, redirect, exists and the exp= target). A trailing
root dot does not count towards the 253.

--- a/src/include/spf_internal.h
+++ b/src/include/spf_internal.h
@@ -19,6 +19,8 @@
 #ifndef INC_SPF_INTERNAL
 #define INC_SPF_INTERNAL
 
+#include <string.h>
+
 #ifndef TRUE
 #define TRUE 1
 #define FALSE 0
@@ -137,6 +139,23 @@
 
 char *SPF_sanitize( SPF_server_t *spf_server, char *str );
 
+/* RFC 7208 7.3: an expanded domain name over 253 chars loses labels on
+ * the left until it fits; a trailing dot (the root) does not count. */
+static inline const char *SPF_domain_truncate( const char *domain )
+{
+	size_t			 len = strlen(domain);
+	const char		*dot;
+
+	if (len > 0 && domain[len - 1] == '.')
+		len--;
+
+	while (len > 253 && (dot = strchr(domain, '.')) != NULL) {
+		len -= dot + 1 - domain;
+		domain = dot + 1;
+	}
+	return domain;
+}
+
 void SPF_print_sizeof(void);
 
